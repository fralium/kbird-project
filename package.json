{
  "name": "kbird",
  "version": "1.2.0",
  "description": "单机鸟友观鸟笔记本",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf .next",
    "dev": "next dev --webpack -p 13080",
    "dev:clean": "npm run clean && npm run dev",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint:fix": "eslint . --fix",
    "build": "cross-env NODE_ENV=production next build --webpack",
    "start": "cross-env NODE_ENV=production next start -H 127.0.0.1 -p 13080",
    "server": "nodemon server/index.js",
    "start:all": "npm run prod:all",
    "stop:all": "npm run stop:windows",
    "stop:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-windows.ps1",
    "restart:all": "npm run prod:all",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "prod:all": "concurrently \"npm run server\" \"npm run start\"",
    "build:prod": "npm run build",
    "start:prod": "npm run build:prod && npm run prod:all",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "stable:tag": "powershell -ExecutionPolicy Bypass -File ./scripts/tag-stable.ps1",
    "stable:rollback": "powershell -ExecutionPolicy Bypass -File ./scripts/rollback-to-stable.ps1"
  },
  "keywords": [
    "鸟类",
    "收集",
    "整理",
    "摄影"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^7.3.2",
    "form-data": "^4.0.4",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "mongoose": "^7.4.3",
    "multer": "^2.3.0",
    "next": "^16.2.4",
    "node-cache": "^5.1.2",
    "papaparse": "^5.5.3",
    "pinyin": "^4.0.0",
    "pinyin-pro": "^3.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "sanitize-html": "^2.17.3",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "glob": "^10.0.0",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
