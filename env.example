# =============================================================================
# KBird 环境变量模板
# 用法：复制为本目录下的 .env（install.ps1 会自动复制并补全数据路径）
#       copy env.example .env
# 也可在首次 /init 向导或「个人设置 → 服务与密钥」中由 GUI 写入本文件
# （地图/AI/库名等）；改完后请重启 KBird-Desktop.bat 才会生效。
# 注意：.env 含本机路径与密钥，不要提交到 Git / Gitee
# =============================================================================

# --- 数据库 -----------------------------------------------------------------
# 本机 MongoDB 连接串。库名写在 URL 末尾。
# 新克隆首次启动时：若仍是下方模板库名，会自动改成该安装专用库（避免多份程序共用一个库）。
# 已在用的安装请保持自己的 URI，不要删 KBIRD_INSTANCE_READY。
# 库不存在时，首次写入数据会自动创建。
MONGODB_URI=mongodb://localhost:27017/kbird
# KBIRD_INSTANCE_READY=1

# （可选）手动指定测试库示例：
# MONGODB_URI=mongodb://localhost:27017/kbird_test

# --- 登录令牌 ---------------------------------------------------------------
# 用于签发/校验登录 JWT。本机随便填一长串即可；对外部署请换成强随机值。
# 生成示例：node scripts/generate-jwt-secret.js
# 生产环境建议至少 32 字符。
JWT_SECRET=your-jwt-secret-key-here

# 生产环境首次访问 /init 创建管理员时可选的保护令牌（请求头 x-setup-token）。
# 本机单机模式通常不用开。
# INIT_SETUP_TOKEN=change-me-to-a-long-random-string

# --- 端口与网址 -------------------------------------------------------------
# 后端 Express API 端口（与下面 NEXT_PUBLIC_API_URL 保持一致）
PORT=13082

# 前端浏览器里请求 API 的地址（开发时一般指向本机后端）
NEXT_PUBLIC_API_URL=http://localhost:13082

# 浏览器访问前端的地址（需与 next 实际端口一致，默认 13080）
SITE_URL=http://localhost:13080
SITE_NAME=KBird
SITE_DESCRIPTION=观鸟笔记本

# 若前后端不同域部署，填写允许的前端 origin（逗号分隔），用于 CORS。
# 不配则默认只允许本机 http://localhost:13080
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 经 Nginx 等反代时设为 1，便于限流识别真实客户端 IP
# TRUST_PROXY=1

# Next.js pages/api 的 CORS Origin（一般不用配，会回退到 SITE_URL）
# 勿使用 *（与带 Cookie 的登录不兼容）
# NEXT_PUBLIC_NEXT_API_CORS_ORIGIN=http://localhost:13080

# --- 个人数据目录（安装时自动写入，一般不用改）-------------------------------
# install.ps1 / init-database.ps1 会运行：node scripts/ensure-kbird-data.js
# 自动在「代码仓库的上一级」创建 KBird-Data，并写入下面两项绝对路径，例如：
#
#   D:/somewhere/kbird/           ← 代码（Git）
#   D:/somewhere/KBird-Data/      ← 个人数据（勿推 Gitee）
#     uploads/                    ← 照片、头像、项目附件
#     backups/                    ← 备份 zip
#     mongo-dumps/
#     personal/
#
# 不配时程序默认也是同级 ../KBird-Data。仅在你想换盘符/目录时再改。
# KBIRD_DATA_ROOT=
# UPLOAD_PATH=

# 单张上传大小上限（字节）。5242880 = 5MB
MAX_FILE_SIZE=5242880

# --- 功能开关 / 单机模式 ----------------------------------------------------
# 是否开放注册页。单机自用建议 false（用 /init 建管理员即可）
ENABLE_REGISTRATION=false
ENABLE_COMMENTS=true
ENABLE_UPLOAD=true

# 单机模式：未设置时服务端也按 true。设 false 可切回多用户行为
SINGLE_USER_MODE=true
# 本机自动登录用的用户名（需库里已有该用户；首次请先走 /init）
DEFAULT_USER=admin
# 仅本机回环（127.0.0.1 / ::1）自动登录；点退出后当次会话不再自动登
AUTO_LOGIN=true

# --- 外观（可选）-----------------------------------------------------------
THEME=default
PRIMARY_COLOR=#4CAF50
SECONDARY_COLOR=#2196F3

# development | production
NODE_ENV=development

# --- 地图（可选；不配也能用，部分页会走简易底图）-----------------------------
# 优先级：百度（浏览器 AK）→ 天地图 → Leaflet 兜底
# 详见 docs/MAP_SETUP.md、docs/BAIDU_MAP.md、docs/TIANDITU_MAP.md
#
# 百度地图开放平台：https://lbsyun.baidu.com/apiconsole/key
# 应用类型选「浏览器端」；白名单加 localhost / 127.0.0.1（端口 13080）
# NEXT_PUBLIC_BAIDU_MAP_AK=your-baidu-browser-ak
#
# 天地图：https://console.tianditu.gov.cn/
# 浏览器端 Key（地图展示）；服务器端 Key（地名搜索/地理编码，勿加 NEXT_PUBLIC_ 前缀）
# NEXT_PUBLIC_TIANDITU_TK=your-browser-tk
# TIANDITU_SERVER_TK=your-server-tk

# --- AI（可选；不配则识鸟/对话相关功能不可用）--------------------------------
# OpenAI 兼容接口：对话、草稿、部分识鸟视觉等。按厂商改 BASE_URL + MODEL。
# 对话超时（毫秒）；模型较慢时可调到 120000～180000
# OPENAI_CHAT_TIMEOUT_MS=120000
# 思考模式全局兜底：enabled | disabled | auto（不配则交给前端/厂商默认）
# OPENAI_THINKING=
#
# 豆包（火山方舟）示例：
# OPENAI_API_KEY=your-ark-api-key
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_MODEL=doubao-seed-2-0
#
# DeepSeek 示例：
# OPENAI_API_KEY=your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
#
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_MODEL=doubao-seed-2-0

# HHO 认鸟专用（可选）：https://ai.open.hhodata.com/#introduce
HHO_API_KEY=
HHO_API_URL=https://api.open.hhodata.com/v1/bird/identify
