# Database Configuration
MONGODB_URI=mongodb://localhost:27017/kbird

# JWT Secret Key (Use a more secure key in production)
# Generate method: node scripts/generate-jwt-secret.js
# Production: must be at least 32 characters
JWT_SECRET=your-jwt-secret-key-here

# Required in production: token for first-time /api/init admin setup
# Header: x-setup-token
# INIT_SETUP_TOKEN=change-me-to-a-long-random-string

# Server Port（后端 API，避免与常见 3000/3002 冲突）
PORT=13082

# 个人数据根 / 上传目录：安装时由 scripts/ensure-kbird-data.js 自动写入，一般不用改。
# 默认与代码仓库同级：../KBird-Data 与 ../KBird-Data/uploads（推 Gitee 不会带上）
# KBIRD_DATA_ROOT=
# UPLOAD_PATH=
MAX_FILE_SIZE=5242880

# Frontend API URL（需与 PORT 一致）
NEXT_PUBLIC_API_URL=http://localhost:13082

# 生产环境前端域名（逗号分隔），用于 CORS；不配则仅允许本机 :13080
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 反代部署时开启，便于限流识别真实客户端 IP
# TRUST_PROXY=1

# Website Configuration（前端访问地址，需与 next dev -p 一致）
SITE_NAME=KBird
SITE_DESCRIPTION=单机鸟友观鸟笔记本
SITE_URL=http://localhost:13080

# Next.js pages/api 响应头 Access-Control-Allow-Origin（不配则回退为 SITE_URL）
# 与前端实际访问 origin 一致；勿使用 *（与带 Cookie 的跨域不兼容）
# NEXT_PUBLIC_NEXT_API_CORS_ORIGIN=http://localhost:13080

# Feature Toggles
# 单机鸟友自用：默认关闭开放注册；需要多账号时再设 ENABLE_REGISTRATION=true
ENABLE_REGISTRATION=false
ENABLE_COMMENTS=true
ENABLE_UPLOAD=true

# Personal Mode（单机鸟友自用，推荐默认）
# SINGLE_USER_MODE 未设置时服务端也按 true 处理；显式 false 可切回多用户
SINGLE_USER_MODE=true
# 本机自动登录用户名；需与实际持有观察记录的账号一致（或留空由服务端回退到有数据的账号）
DEFAULT_USER=admin
# 本机回环自动登录（仅 127.0.0.1 / ::1）；主动退出后当次会话不再自动登
AUTO_LOGIN=true

# Theme Configuration
THEME=default
PRIMARY_COLOR=#4CAF50
SECONDARY_COLOR=#2196F3

# Node Environment
NODE_ENV=development

# 地图展示（可选，优先百度 → 天地图 → Leaflet 兜底）
# 百度地图：https://lbsyun.baidu.com/apiconsole/key
# 应用类型选「浏览器端」；本地请把 localhost、127.0.0.1 加入白名单（端口 13080）
# NEXT_PUBLIC_BAIDU_MAP_AK=your-baidu-browser-ak

# 天地图 (可选)
# 申请：https://cloudcenter.tianditu.gov.cn/center/development/myApp
# 浏览器端 Key：用于页面地图展示（记录详情页、地点编辑页地图）
# NEXT_PUBLIC_TIANDITU_TK=your-browser-tk
# 服务器端 Key：用于「地名搜索」（地点编辑页搜索五常湿地等），否则会报「权限类型错误」
# 需在天地图再创建一个应用类型为「服务器端」的 Key
# 地理编码接口需登录，且只使用本服务端 Key（不会回退到 NEXT_PUBLIC_TIANDITU_TK）
# TIANDITU_SERVER_TK=your-server-tk

# OpenAI 兼容大模型（对话 / 观鸟点 / 知识 / 认鸟视觉）
# 按厂商改 BASE_URL + MODEL，前端会识别展示名（豆包 / DeepSeek 等）
# 对话超时（毫秒），豆包偏慢时可调到 120000～180000
# OPENAI_CHAT_TIMEOUT_MS=120000
# 思考模式全局兜底（enabled|disabled|auto）。不配则交给前端用户选项 / 厂商默认
# OPENAI_THINKING=
#
# 豆包（火山方舟）:
# OPENAI_API_KEY=your-ark-api-key
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_MODEL=doubao-seed-2-0
#
# DeepSeek:
# OPENAI_API_KEY=your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
#
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_MODEL=doubao-seed-2-0

# HHO AI（认鸟专用，可选）
# 获取API Key: https://ai.open.hhodata.com/#introduce
HHO_API_KEY=
HHO_API_URL=https://api.open.hhodata.com/v1/bird/identify