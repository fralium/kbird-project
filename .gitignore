backups/
reports/

# User-generated under public/images; keep only bundled defaults
public/images/*
!public/images/default-bird.svg
!public/images/knowledge/
!public/images/knowledge/**

# Local full seed (may reference personal media) — public seed is birds-public.json
seeds/birds-array.json
*.bson
*.zip
*.dump

